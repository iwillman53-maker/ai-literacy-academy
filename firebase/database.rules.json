{
  "rules": {
    "admins": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "decks": {
      "$deck": {
        "state": {
          ".read": true,
          ".write": "auth != null && auth.uid === 'Ia7xk9kjtfO40r4SKXkqS7yTMip2'",
          ".validate": "newData.hasChildren(['slide', 'locked', 'pdf'])",
          "slide": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000" },
          "locked": { ".validate": "newData.isBoolean()" },
          "pdf": { ".validate": "newData.isBoolean()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "viewers": {
          ".read": true,
          "$vid": {
            ".write": "$vid.length <= 30",
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
